// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  UMKM
  SUPPLIER
}

model User {
  id              BigInt           @id @default(autoincrement())
  username        String           @unique
  email           String           @unique
  role            Role             @default(UMKM)
  password        String
  noWa            String?
  profileUmkm     ProfileUmkm?
  profileSupplier ProfileSupplier?
  created_at      DateTime         @default(now())
  updated_at      DateTime?        @updatedAt
}

model ProfileUmkm {
  id          BigInt            @id @default(autoincrement())
  userId      BigInt            @unique
  fotoProfile String?
  bgProfile   String?
  umkmName    String?
  bio         String?
  following   ProfileSupplier[] @relation("UmkmSupplierFollows")
  address     Address?
  created_at  DateTime          @default(now())
  updated_at  DateTime?         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileSupplier {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @unique
  fotoProfile  String?
  bgProfile    String?
  supplierName String?
  bio          String?
  followers    ProfileUmkm[] @relation("UmkmSupplierFollows")
  address      Address?
  created_at   DateTime      @default(now())
  updated_at   DateTime?     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id                BigInt           @id @default(autoincrement())
  provinsi          String
  regency         String
  street            String
  detail            String?
  profileUmkmId     BigInt?          @unique
  profileUmkm       ProfileUmkm?     @relation(fields: [profileUmkmId], references: [id], onDelete: Cascade)
  profileSupplierId BigInt?          @unique
  profileSupplier   ProfileSupplier? @relation(fields: [profileSupplierId], references: [id], onDelete: Cascade)
  created_at        DateTime         @default(now())
  updated_at        DateTime?        @updatedAt
}

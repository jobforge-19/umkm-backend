// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgres"
}

enum Role {
  ADMIN
  UMKM
  SUPPLIER
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  fullName        String?
  email           String           @unique
  role            Role             @default(UMKM)
  password        String
  noWa            String?
  nik             String?
  verified        Boolean          @default(false)
  profileUmkm     ProfileUmkm?
  profileSupplier ProfileSupplier?
  created_at      DateTime         @default(now())
  updated_at      DateTime?        @updatedAt
}

model ProfileUmkm {
  id          Int               @id @default(autoincrement())
  userId      Int               @unique
  fotoProfile String?
  bgProfile   String?
  businessName    String?
  bio         String?
  following   ProfileSupplier[] @relation("UmkmSupplierFollows")
  address     Address?
  created_at  DateTime          @default(now())
  updated_at  DateTime?         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileSupplier {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  fotoProfile  String?
  bgProfile    String?
  businessName String?
  bio          String?
  nib          String?    
  followers    ProfileUmkm[] @relation("UmkmSupplierFollows")
  address      Address?
  created_at   DateTime      @default(now())
  updated_at   DateTime?     @updatedAt
  products     Products[]



  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id                Int             @id @default(autoincrement())
  province          String?
  regency           String?
  street            String
  details            String?
  profileUmkmId     Int?             @unique
  profileUmkm       ProfileUmkm?     @relation(fields: [profileUmkmId], references: [id], onDelete: Cascade)
  profileSupplierId Int?             @unique
  profileSupplier   ProfileSupplier? @relation(fields: [profileSupplierId], references: [id], onDelete: Cascade)
  created_at        DateTime         @default(now())
  updated_at        DateTime?        @updatedAt
}

enum Product_Categories {
  JAGUNG
  BIJI_BIJIAN
  SAYURAN
  BUAH_BUAHAN
  UMBI_UMBIAN
  BERAS_DAN_GABAH
  REMPAH_DAN_BUMBU
}

enum Unit {
  KG
  IKAT
  BOTOL
  PACK
  ONS
  TON
  GRAM
  LITER
  PCS
  BOX
  KARUNG
}

enum Production_Status {
  PANEN
  HABIS
  PENGOLAHAN
  READY
}

model Products {
  id            Int              @id @default(autoincrement())
  id_supplier   Int
  category      Product_Categories
  product_name  String
  unit          Unit
  unit_price    Int
  moq           Float @default(1.0)
  stock         Float @default(1.0)
  product_photo String?
  description   String?
  productStatus Production_Status? @default(READY)
  available     Boolean @default(true)
  createdAt     DateTime         @default(now())


  idSupplier  ProfileSupplier  @relation(fields: [id_supplier], references: [id], onDelete: Cascade)
}

